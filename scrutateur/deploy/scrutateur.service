[Unit]
Description=Scrutateur RT_Meteo_PG (releve des instances PostgreSQL toutes les minutes)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scrutateur
Group=scrutateur
# Fichier root:scrutateur, mode 0640, hors Git (modele : scrutateur.env.example)
EnvironmentFile=/etc/scrutateur/scrutateur.env
WorkingDirectory=/opt/scrutateur/app
ExecStart=/opt/scrutateur/venv/bin/python -m scrutateur
Restart=on-failure
RestartSec=10
# Un releve en cours se termine en 40 s au plus (delais cible, 2 requetes) avant l'arret
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
