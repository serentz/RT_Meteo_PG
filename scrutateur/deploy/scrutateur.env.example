# Modele de /etc/scrutateur/scrutateur.env (a creer sur le bastion, jamais dans Git).
#   sudo install -m 0640 -o root -g scrutateur scrutateur.env.example /etc/scrutateur/scrutateur.env
# Puis remplacer CHANGER_MOI. Si le mot de passe contient des caracteres speciaux (@ : / ? # %),
# les encoder en pourcentage dans l'URL (ex. @ -> %40).
# Base de STOCKAGE (pg01, base meteo) : ce n'est pas une instance surveillee.
# Les instances surveillees (hote, port, base, login, mot de passe) sont dans la table meteo.instance.
SCRUTATEUR_STOCKAGE_DSN=postgresql://scrutateur:CHANGER_MOI@pg01:5432/meteo

# Facultatif (valeurs par defaut ci-dessous)
#SCRUTATEUR_INTERVALLE_S=60
#SCRUTATEUR_MAX_PARALLELE=16
#SCRUTATEUR_CIBLE_CONNEXION_TIMEOUT_S=10
#SCRUTATEUR_CIBLE_REQUETE_TIMEOUT_S=15
# disable, allow, prefer, require, verify-ca, verify-full
#SCRUTATEUR_CIBLE_SSLMODE=prefer
