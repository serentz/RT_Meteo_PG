          "editorMode": "code",
          "rawSql": "SELECT '/public/img/meteo/' || CASE niveau WHEN 'soleil' THEN 'Soleil.png' WHEN 'nuage' THEN 'nuages.png' WHEN 'orage' THEN 'orages.png' ELSE 'lune_dors.png' END AS \"Météo\", libelle AS \"Indicateur\", valeur AS \"Valeur\", unite AS \"Unité\",\n       warning AS \"Seuil nuage\", alarme AS \"Seuil orage\", niveau AS \"Etat\"\nFROM meteo.etat_indicateur WHERE instance = '$instance' ORDER BY ordre"
