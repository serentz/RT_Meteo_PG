    {
      "id": 4,
      "type": "table",
      "title": "Transactions ouvertes, de la plus longue à la plus courte",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "meteo-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "meteo-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH dernier AS (\n  SELECT dm.mesure_id FROM meteo.derniere_mesure dm JOIN meteo.instance i USING (instance_id)\n  WHERE i.nom = '$instance' AND dm.statut = 'ok'\n), t AS (\n  SELECT x.* FROM meteo.processus x JOIN dernier USING (mesure_id) WHERE x.transaction_s IS NOT NULL\n)\nSELECT transaction_s AS \"Durée (s)\", to_char(transaction_debut, 'YYYY-MM-DD HH24:MI:SS') AS \"Début\", pid AS \"pid\", login AS \"Login\",\n       base AS \"Base\", hote AS \"Hôte\", programme AS \"Programme\", cmd AS \"Commande\", statut AS \"Statut\"\nFROM t\nUNION ALL\nSELECT NULL, NULL, NULL, 'Aucune transaction ouverte', NULL, NULL, NULL, NULL, NULL\nWHERE EXISTS (SELECT 1 FROM dernier) AND NOT EXISTS (SELECT 1 FROM t)\nORDER BY \"Durée (s)\" DESC NULLS LAST, \"pid\""
        }
      ],
