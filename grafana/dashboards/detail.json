    {
      "id": 3,
      "type": "table",
      "title": "Processus du dernier relevé : requêtes en cours, bloqués et bloqueurs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "meteo-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "meteo-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH dernier AS (\n  SELECT dm.mesure_id FROM meteo.derniere_mesure dm JOIN meteo.instance i USING (instance_id)\n  WHERE i.nom = '$instance' AND dm.statut = 'ok'\n), t AS (\n  SELECT p.* FROM meteo.processus p JOIN dernier USING (mesure_id)\n)\nSELECT pid AS \"pid\", login AS \"Login\", base AS \"Base\", hote AS \"Hôte\", programme AS \"Programme\",\n       cmd AS \"Commande\", statut AS \"Statut\", attente AS \"Attente\", bloqueur_pid AS \"Bloqué par\",\n       blocage_s AS \"Blocage (s)\", execution_s AS \"Requête (s)\"\nFROM t\nUNION ALL\nSELECT NULL, 'Aucune requête en cours ni blocage', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL\nWHERE EXISTS (SELECT 1 FROM dernier) AND NOT EXISTS (SELECT 1 FROM t)\nORDER BY \"Blocage (s)\" DESC NULLS LAST, \"Requête (s)\" DESC NULLS LAST, \"pid\""
        }
      ],
      "fieldConfig": {
        "defaults": {
